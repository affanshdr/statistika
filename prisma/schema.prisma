generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id          String   @id @default(uuid())
  username    String   @unique
  displayName String   @map("display_name")
  pin         String
  avatarId    String   @default("default") @map("avatar_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  progress     PlayerProgress?
  gameSessions GameSession[]
  masteries    LearningMastery[]

  @@map("players")
}

model PlayerProgress {
  id             String   @id @default(uuid())
  playerId       String   @unique @map("player_id")
  totalXp        Int      @default(0) @map("total_xp")
  playerLevel    Int      @default(1) @map("player_level")
  unlockedLevels Int[]    @default([1]) @map("unlocked_levels")
  levelStars     Json     @default("{}") @map("level_stars") // { "1": 3, "2": 2 }
  badges         String[] @default([])
  updatedAt      DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_progress")
}

model GameSession {
  id              String   @id @default(uuid())
  playerId        String   @map("player_id")
  levelId         Int      @map("level_id")
  xpEarned        Int      @default(0) @map("xp_earned")
  score           Int      @default(0)
  durationSeconds Int      @default(0) @map("duration_seconds")
  livesRemaining  Int      @default(3) @map("lives_remaining")
  mistakeCount    Int      @default(0) @map("mistake_count")
  verdictAnswer   String?  @map("verdict_answer")
  isCorrect       Boolean  @default(false) @map("is_correct")
  details         Json?
  createdAt       DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("game_sessions")
}

model LearningMastery {
  id           String   @id @default(uuid())
  playerId     String   @map("player_id")
  topic        String   // "mean" | "median" | "modus" | "kuartil" | dll
  masteryScore Int      @default(0) @map("mastery_score")
  accuracyRate Float    @default(0.0) @map("accuracy_rate")
  updatedAt    DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, topic])
  @@map("learning_mastery")
}
