generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum GeftStatus {
  not_taken
  completed
}

model Classroom {
  id    String @id @default(uuid())
  name  String // "X MIPA 1"
  grade String // "X", "XI", "XII"
  major String // "MIPA", "IPS"

  students Student[]
  teams    Team[]

  @@map("classrooms")
}

model Student {
  id          String     @id @default(uuid())
  name        String
  nisn        String     @unique
  classroomId String     @map("classroom_id")
  geftStatus      GeftStatus @default(not_taken) @map("geft_status")
  diagnosticScore Int?       @map("diagnostic_score")
  diagnosticLevel String?    @map("diagnostic_level") // "tinggi" | "sedang" | "rendah"
  lastSeenAt      DateTime?  @map("last_seen_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  geftResult   GeftResult?
  gameSessions GameSession[]
  leaderboard  Leaderboard?
  teamMembers  TeamMember[]
  teamMessages TeamMessage[]

  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@map("students")
}

enum CognitiveStyle {
  FI
  FD
}

model GeftResult {
  id             String         @id @default(uuid())
  studentId      String         @unique @map("student_id")
  score          Int
  cognitiveStyle CognitiveStyle @map("cognitive_style")
  completedAt    DateTime       @default(now()) @map("completed_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("geft_results")
}

model GameSession {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  levelId        Int      @map("level_id")
  cognitiveStyle String   @map("cognitive_style")
  xpEarned       Int      @map("xp_earned")
  livesRemaining Int      @map("lives_remaining")
  timeTaken      Int      @map("time_taken")
  verdictAnswer  String   @map("verdict_answer")
  isCorrect      Boolean  @map("is_correct")
  postTestScore  Int?     @map("post_test_score")
  postTestCompleted Boolean @default(false) @map("post_test_completed")
  lkpdAnswers    Json?    @map("lkpd_answers")
  lkpdCompleted  Boolean  @default(false) @map("lkpd_completed")
  createdAt      DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("game_sessions")
}

model Leaderboard {
  id        String   @id @default(uuid())
  studentId String   @unique @map("student_id")
  username  String
  totalXp   Int      @default(0) @map("total_xp")
  badges    String[] @default([])
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("leaderboard")
}

model ChatbotKnowledge {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("umum") // "statistika" | "gameplay" | "umum"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chatbot_knowledge")
}

model ModulAjar {
  id        String   @id @default(uuid())
  title     String
  subject   String   @default("Matematika")
  grade     String   @default("E / X")
  topic     String
  duration  String   @default("2 x 45 Menit")
  session   String   @default("Pertama")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("modul_ajar")
}

model Team {
  id            String   @id @default(uuid())
  classroomId   String   @map("classroom_id")
  levelId       Int      @map("level_id")
  status        String   @default("WAITING") // "WAITING" | "PLAYING" | "COMPLETED"
  currentStep   Int      @default(0) @map("current_step")
  histogramState Json?    @map("histogram_state")
  verdictAnswer String   @default("") @map("verdict_answer")
  isCorrect     Boolean  @default(false) @map("is_correct")
  gamePhase     String   @default("cutscene_comments") @map("game_phase")
  readyVotes    Json?    @map("ready_votes")
  formulaState  Json?    @map("formula_state")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  members      TeamMember[]
  chatMessages TeamMessage[]
  classroom    Classroom     @relation(fields: [classroomId], references: [id])

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  studentId String   @map("student_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentId])
  @@map("team_members")
}

model TeamMessage {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  studentId  String   @map("student_id")
  senderName String   @map("sender_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("team_messages")
}

