'use client'

import React, { useState, useEffect, useMemo, useCallback } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { CLASS_STUDENTS, getClassStudents, QuizDoor } from '@/app/siswa/game/_levels/level1/data/level1Data'
import { useGameStore } from '@/lib/store/gameStore'
import { gameAudio } from '@/lib/utils/gameAudio'

interface WaliKelasModalProps {
  door: QuizDoor
  studentsData?: Record<string, { teacher: string; comment: string; image?: string; students: { name: string; time: number }[] }>
  onCollectData: () => void
  onClose: () => void
}

interface QuizData {
  conceptTag: string
  introQuote: string
  questionText: string
  correctAnswer: number
  unit: string
  options: number[]
  explanation: string
}

function generatePreLearningQuiz(doorId: string, students: { name: string; time: number }[]): QuizData {
  const times = students.map(s => s.time)

  if (doorId === 'A1') {
    // ── KELAS VII-A (5 Siswa): Jangkauan Data (Nilai Terbesar - Terkecil) ──
    const maxTime = Math.max(...times)
    const minTime = Math.min(...times)
    const maxStudent = students.find(s => s.time === maxTime)?.name || 'terlama'
    const minStudent = students.find(s => s.time === minTime)?.name || 'tersingkat'
    const diff = maxTime - minTime

    const pool = new Set<number>([diff])
    const candidateOffsets = [1, -1, 2, -2, 3]
    for (const offset of candidateOffsets) {
      if (pool.size >= 4) break
      const cand = diff + offset
      if (cand > 0 && !pool.has(cand)) pool.add(cand)
    }

    return {
      conceptTag: 'PRE-PEMBELAJARAN 1: Jangkauan Data (Nilai Max − Min)',
      introQuote: 'Karena kamu telat datang, jawab dulu tantangan Ibu baru datanya boleh diambil!',
      questionText: `Amati data 5 siswa di atas! Berapa selisih waktu layar antara ${maxStudent} (${maxTime} jam) dan ${minStudent} (${minTime} jam)?`,
      correctAnswer: diff,
      unit: 'jam',
      options: Array.from(pool).sort((a, b) => a - b),
      explanation: `Tepat sekali! Selisih antara nilai tertinggi (${maxTime} jam) dan terendah (${minTime} jam) disebut Jangkauan (Range) = ${diff} jam.`,
    }
  }

  if (doorId === 'A2') {
    // ── KELAS VII-B (7 Siswa): Memilah Data & Frekuensi Kriteria (> cutoff) ──
    let cutoff = 4
    let matching = students.filter(s => s.time > cutoff).length
    if (matching < 2 || matching > 5) {
      cutoff = 3
      matching = students.filter(s => s.time > cutoff).length
    }

    const pool = new Set<number>([matching])
    const candidateOffsets = [1, -1, 2, -2, 3]
    for (const offset of candidateOffsets) {
      if (pool.size >= 4) break
      const cand = matching + offset
      if (cand >= 1 && cand <= 7 && !pool.has(cand)) pool.add(cand)
    }

    return {
      conceptTag: 'PRE-PEMBELAJARAN 2: Menghitung Frekuensi Data (f)',
      introQuote: 'Eits, anak yang telat harus kena uji ketelitian dulu! Jawab ini baru Bapak berikan datanya.',
      questionText: `Dari 7 siswa di kelas ini, ada berapa banyak siswa yang waktu layarnya LEBIH DARI ${cutoff} jam sehari?`,
      correctAnswer: matching,
      unit: 'siswa',
      options: Array.from(pool).sort((a, b) => a - b),
      explanation: `Benar! Ada ${matching} siswa dengan waktu layar > ${cutoff} jam. Menghitung banyaknya data seperti ini disebut menentukan Frekuensi (f).`,
    }
  }

  if (doorId === 'B1') {
    // ── KELAS VIII-A (4 Siswa): Menjumlahkan Seluruh Nilai Data (Sigma / Σx) ──
    const sum = times.reduce((a, b) => a + b, 0)
    const formulaStr = times.join(' + ')

    const pool = new Set<number>([sum])
    const candidateOffsets = [2, -2, 3, -3, 4]
    for (const offset of candidateOffsets) {
      if (pool.size >= 4) break
      const cand = sum + offset
      if (cand > 0 && !pool.has(cand)) pool.add(cand)
    }

    return {
      conceptTag: 'PRE-PEMBELAJARAN 3: Jumlah Seluruh Data (Sigma / Σx)',
      introQuote: 'Bagus sudah datang, tapi selesaikan dulu teka-teki Ibu sebelum membawa data ini!',
      questionText: `Karena sampel di kelas ini hanya 4 siswa, berapa jumlah total waktu layar jika ke-4 siswa digabungkan? (${formulaStr} = ?)`,
      correctAnswer: sum,
      unit: 'jam',
      options: Array.from(pool).sort((a, b) => a - b),
      explanation: `Luar biasa! Total seluruh nilai data (Σx) adalah ${sum} jam. Nilai total ini adalah modal penting sebelum kita mempelajari rata-rata!`,
    }
  }

  // ── KELAS VIII-B (8 Siswa): Deteksi Nilai Pencilan (Outlier) & Selisih Ekstrem ──
  const sorted = [...students].sort((a, b) => b.time - a.time)
  const outlier = sorted[0]
  const secondHighest = sorted[1]
  const diff = outlier.time - secondHighest.time
  const targetVal = diff > 0 ? diff : outlier.time

  const pool = new Set<number>([targetVal])
  const candidateOffsets = [2, -2, 3, -3, 4]
  for (const offset of candidateOffsets) {
    if (pool.size >= 4) break
    const cand = targetVal + offset
    if (cand > 0 && !pool.has(cand)) pool.add(cand)
  }

  return {
    conceptTag: 'PRE-PEMBELAJARAN 4: Deteksi Nilai Pencilan (Outlier)',
    introQuote: 'Hukuman karena terlambat! Perhatikan baik-baik data 8 siswa ini sebelum mengambilnya.',
    questionText: `Ada 1 siswa bernama ${outlier.name} dengan waktu layar melonjak ekstrem (${outlier.time} jam) dibanding teman lainnya. Berapa selisih waktu ${outlier.name} dengan siswa tertinggi kedua (${secondHighest.name}: ${secondHighest.time} jam)?`,
    correctAnswer: targetVal,
    unit: 'jam',
    options: Array.from(pool).sort((a, b) => a - b),
    explanation: `Tepat sekali! Selisihnya ${targetVal} jam. Nilai ${outlier.time} jam yang melonjak sangat jauh dari kelompok data ini disebut Pencilan (Outlier).`,
  }
}

export default function WaliKelasModal({ door, studentsData, onCollectData, onClose }: WaliKelasModalProps) {
  const level1Dataset = useGameStore(s => s.level1Dataset)
  const currentStudents = studentsData || getClassStudents(level1Dataset)
  const info = currentStudents[door.id] || CLASS_STUDENTS[door.id]

  const quiz = useMemo(() => {
    if (!info?.students) return null
    return generatePreLearningQuiz(door.id, info.students)
  }, [door.id, info])

  const [selectedAnswer, setSelectedAnswer] = useState<number | null>(null)
  const [isCorrect, setIsCorrect] = useState<boolean | null>(null)
  const [shake, setShake] = useState<number>(0)

  const handleSelectOption = useCallback((choice: number) => {
    if (!quiz || isCorrect === true) return
    setSelectedAnswer(choice)

    if (choice === quiz.correctAnswer) {
      setIsCorrect(true)
      gameAudio.playSuccess()
    } else {
      setIsCorrect(false)
      setShake(prev => prev + 1)
      gameAudio.playError()
    }
  }, [quiz, isCorrect])

  const handleDevPass = useCallback(() => {
    if (!quiz) return
    setSelectedAnswer(quiz.correctAnswer)
    setIsCorrect(true)
    gameAudio.playSuccess()
  }, [quiz])

  // Hotkey [U] or [0] to auto pass question (Dev & testing)
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'u' || e.key === 'U' || e.key === '0') {
        handleDevPass()
      }
    }
    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
  }, [handleDevPass])

  if (!info || !quiz) return null

  return (
    <div
      data-testid="wali-kelas-modal-backdrop"
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 550,
        background: 'rgba(8, 16, 26, 0.88)',
        backdropFilter: 'blur(8px)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        padding: 'clamp(8px, 2vh, 20px)',
        boxSizing: 'border-box',
      }}
    >
      <motion.div
        initial={{ opacity: 0, scale: 0.9, y: 16 }}
        animate={{ opacity: 1, scale: 1, y: 0 }}
        exit={{ opacity: 0, scale: 0.9, y: 16 }}
        transition={{ type: 'spring', damping: 24, stiffness: 350 }}
        data-testid="wali-kelas-modal-content"
        style={{
          maxWidth: 540,
          width: '100%',
          maxHeight: '94vh',
          overflowY: 'auto',
          position: 'relative',
          background: 'linear-gradient(135deg, #FDF8EC 0%, #F5E8C7 100%)',
          border: '2.5px solid #8C6239',
          borderRadius: 'clamp(14px, 2vw, 22px)',
          padding: 'clamp(14px, 2vh, 22px) clamp(16px, 2.5vw, 24px)',
          display: 'flex',
          flexDirection: 'column',
          gap: 'clamp(10px, 1.4vh, 14px)',
          boxShadow: '0 20px 50px rgba(0, 0, 0, 0.65), inset 0 0 25px rgba(180, 140, 80, 0.25)',
          boxSizing: 'border-box',
          color: '#2C1A10',
        }}
      >
        {/* Decorative Viewfinder Brackets */}
        <div style={{ position: 'absolute', top: '10px', left: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '3px 0 0 0' }} />
        <div style={{ position: 'absolute', top: '10px', right: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 3px 0 0' }} />
        <div style={{ position: 'absolute', bottom: '10px', left: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '0 0 0 3px' }} />
        <div style={{ position: 'absolute', bottom: '10px', right: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 0 3px 0' }} />

        {/* Header: Teacher Badge & Class Label + Dev Pass */}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '6px' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
            <span style={{
              background: '#FFFDF7',
              border: '1.5px solid #8C6239',
              borderRadius: '999px',
              padding: '3px 12px',
              fontSize: 'clamp(11.5px, 1.3vw, 13.5px)',
              fontWeight: 900,
              color: '#362014',
              display: 'flex',
              alignItems: 'center',
              gap: '6px',
              boxShadow: '0 2px 4px rgba(0,0,0,0.06)',
            }}>
              <span>👩‍🏫</span>
              <span>{info.teacher}</span>
            </span>
          </div>

          <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
            <span style={{
              fontSize: 'clamp(10px, 1.2vw, 11.5px)',
              fontWeight: 800,
              color: '#0369A1',
              background: 'rgba(2, 132, 199, 0.12)',
              border: '1.5px solid rgba(2, 132, 199, 0.35)',
              padding: '3px 10px',
              borderRadius: '8px',
            }}>
              {door.label}
            </span>

            {/* Discreet Dev Pass Button */}
            <button
              data-testid="btn-dev-pass-wali-quiz"
              onClick={handleDevPass}
              style={{
                background: 'rgba(180, 83, 9, 0.1)',
                border: '1px solid #B45309',
                borderRadius: '6px',
                color: '#92400E',
                fontSize: '9.5px',
                fontWeight: 800,
                padding: '3px 8px',
                cursor: 'pointer',
              }}
              title="Shortcut Dev: Langsung selesaikan tantangan guru ini (Hotkey: [U])"
            >
              ⚡ Pass
            </button>
          </div>
        </div>

        {/* 1. Preview Tabel Data Siswa Kelas */}
        <div style={{
          background: '#FFFDF7',
          border: '1.5px solid #B48C50',
          borderRadius: '14px',
          padding: 'clamp(10px, 1.3vh, 14px)',
          boxShadow: 'inset 0 2px 5px rgba(140, 98, 57, 0.1), 0 2px 6px rgba(0,0,0,0.04)',
        }}>
          <div style={{
            display: 'flex',
            justifyContent: 'space-between',
            alignItems: 'center',
            marginBottom: '8px',
            fontSize: 'clamp(9.5px, 1.1vw, 11px)',
            color: '#9A3412',
            fontWeight: 900,
            letterSpacing: '0.8px',
            textTransform: 'uppercase',
          }}>
            <span>📋 SAMPEL LEMBAR SURVEI KELAS ({info.students.length} SISWA)</span>
            <span style={{ color: '#0369A1', fontWeight: 800 }}>SATUAN: JAM/HARI</span>
          </div>

          <div style={{
            display: 'grid',
            gridTemplateColumns: info.students.length > 5 ? 'repeat(4, 1fr)' : 'repeat(3, 1fr)',
            gap: 'clamp(6px, 0.8vw, 10px)',
          }}>
            {info.students.map((st, idx) => (
              <div
                key={idx}
                style={{
                  background: '#FFFFFF',
                  border: '1px solid #E2E8F0',
                  borderRadius: '8px',
                  padding: 'clamp(4px, 0.6vh, 6px) clamp(6px, 0.8vw, 8px)',
                  display: 'flex',
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  fontSize: 'clamp(10px, 1.2vw, 12px)',
                  boxShadow: '0 1px 3px rgba(0,0,0,0.04)',
                }}
              >
                <span style={{ color: '#334155', fontWeight: 700, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
                  {st.name}
                </span>
                <span style={{
                  fontWeight: 900,
                  color: '#92400E',
                  background: '#FEF3C7',
                  padding: '1px 6px',
                  borderRadius: '4px',
                  border: '1px solid #FDE68A',
                  marginLeft: '4px'
                }}>
                  {st.time}h
                </span>
              </div>
            ))}
          </div>
        </div>

        {/* 2. Kartu Tantangan Pre-Pembelajaran Guru ("Karena Kamu Telat...") */}
        <div style={{
          background: 'linear-gradient(135deg, #FEF3C7 0%, #FFFBEB 100%)',
          border: '1.8px solid #D97706',
          borderRadius: '14px',
          padding: 'clamp(10px, 1.4vh, 14px)',
          display: 'flex',
          flexDirection: 'column',
          gap: 'clamp(6px, 1vh, 10px)',
          boxShadow: '0 3px 10px rgba(180, 140, 80, 0.2)',
        }}>
          {/* Concept Header Badge */}
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '4px' }}>
            <span style={{
              fontSize: 'clamp(8.5px, 1vw, 10px)',
              fontWeight: 900,
              background: '#B45309',
              color: '#FFFFFF',
              padding: '2px 10px',
              borderRadius: '999px',
              letterSpacing: '0.5px',
            }}>
              {quiz.conceptTag}
            </span>
          </div>

          {/* Teacher Dialogue & Prompt */}
          <div>
            <p style={{
              margin: '0 0 4px',
              fontSize: 'clamp(10px, 1.1vw, 11.5px)',
              color: '#78350F',
              fontWeight: 800,
              fontStyle: 'italic',
            }}>
              &ldquo;{quiz.introQuote}&rdquo;
            </p>
            <h4 style={{
              margin: 0,
              fontSize: 'clamp(12px, 1.4vw, 14px)',
              fontWeight: 900,
              color: '#362014',
              lineHeight: 1.35,
            }}>
              {quiz.questionText}
            </h4>
          </div>

          {/* Options Grid (4 Pilihan Ganda) */}
          <motion.div
            key={shake}
            animate={isCorrect === false ? { x: [-6, 6, -5, 5, 0] } : {}}
            transition={{ duration: 0.3 }}
            style={{
              display: 'grid',
              gridTemplateColumns: 'repeat(4, 1fr)',
              gap: 'clamp(4px, 0.8vw, 8px)',
            }}
          >
            {quiz.options.map(opt => {
              const isSelected = selectedAnswer === opt
              const isSelectedCorrect = isSelected && isCorrect === true
              const isSelectedWrong = isSelected && isCorrect === false
              return (
                <button
                  key={opt}
                  data-testid={`wali-quiz-option-${opt}`}
                  disabled={isCorrect === true}
                  onClick={() => handleSelectOption(opt)}
                  style={{
                    padding: 'clamp(7px, 1vh, 11px) 4px',
                    borderRadius: '8px',
                    fontSize: 'clamp(11.5px, 1.3vw, 13.5px)',
                    fontWeight: 900,
                    cursor: isCorrect === true ? 'default' : 'pointer',
                    border: isSelectedCorrect
                      ? '2px solid #059669'
                      : isSelectedWrong
                      ? '2px solid #DC2626'
                      : '1.5px solid #CBD5E1',
                    background: isSelectedCorrect
                      ? 'linear-gradient(180deg, #059669 0%, #047857 100%)'
                      : isSelectedWrong
                      ? 'linear-gradient(180deg, #DC2626 0%, #B91C1C 100%)'
                      : '#FFFFFF',
                    color: isSelectedCorrect ? '#FFFFFF' : isSelectedWrong ? '#FFFFFF' : '#334155',
                    boxShadow: '0 2px 5px rgba(0,0,0,0.06)',
                    transition: 'all 0.15s ease',
                  }}
                >
                  {opt} {quiz.unit} {isSelectedCorrect ? '✓' : isSelectedWrong ? '✕' : ''}
                </button>
              )
            })}
          </motion.div>

          {/* Feedback & Penjelasan */}
          <AnimatePresence>
            {isCorrect === false && (
              <motion.div
                initial={{ opacity: 0, y: -4 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0 }}
                style={{
                  background: '#FEE2E2',
                  border: '1.5px solid #EF4444',
                  borderRadius: '8px',
                  padding: 'clamp(5px, 0.7vh, 8px) clamp(8px, 1vw, 12px)',
                  fontSize: 'clamp(9.5px, 1.1vw, 11.5px)',
                  color: '#991B1B',
                  fontWeight: 800,
                }}
              >
                ❌ Jawabanmu kurang tepat! Amati kembali baris angka pada tabel data di atas.
              </motion.div>
            )}

            {isCorrect === true && (
              <motion.div
                initial={{ opacity: 0, scale: 0.96 }}
                animate={{ opacity: 1, scale: 1 }}
                style={{
                  background: '#ECFDF5',
                  border: '1.5px solid #10B981',
                  borderRadius: '8px',
                  padding: 'clamp(6px, 0.8vh, 10px) clamp(10px, 1.2vw, 14px)',
                  fontSize: 'clamp(10px, 1.1vw, 12px)',
                  color: '#065F46',
                  fontWeight: 800,
                  lineHeight: 1.4,
                }}
              >
                🎉 {quiz.explanation}
              </motion.div>
            )}
          </AnimatePresence>
        </div>

        {/* 3. Action Buttons */}
        <div style={{ display: 'flex', gap: '10px', marginTop: '2px' }}>
          <button
            data-testid="btn-close-wali-kelas"
            onClick={onClose}
            style={{
              flex: 1,
              padding: 'clamp(8px, 1.2vh, 12px) 14px',
              borderRadius: '12px',
              border: '1.5px solid #8C6239',
              background: '#F5E8C7',
              color: '#6B4226',
              fontSize: 'clamp(10.5px, 1.2vw, 12.5px)',
              fontWeight: 800,
              cursor: 'pointer',
              transition: 'all 0.15s',
            }}
          >
            ← Batal
          </button>

          <button
            data-testid="btn-collect-wali-data"
            disabled={isCorrect !== true}
            onClick={() => {
              if (isCorrect !== true) return
              gameAudio.playItemCollect()
              onCollectData()
              onClose()
            }}
            style={{
              flex: 1.8,
              padding: 'clamp(8px, 1.2vh, 12px) 16px',
              borderRadius: '12px',
              border: isCorrect === true ? '1.5px solid rgba(255, 255, 255, 0.4)' : '1.5px solid #CBD5E1',
              background: isCorrect === true
                ? 'linear-gradient(135deg, #0E8388 0%, #0284C7 100%)'
                : '#E2E8F0',
              color: isCorrect === true ? '#FFFFFF' : '#94A3B8',
              fontSize: 'clamp(11px, 1.2vw, 13px)',
              fontWeight: 900,
              cursor: isCorrect === true ? 'pointer' : 'not-allowed',
              boxShadow: isCorrect === true ? '0 6px 20px rgba(14, 131, 136, 0.35)' : 'none',
              transition: 'all 0.2s',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              gap: '6px',
            }}
          >
            <span>{isCorrect === true ? '📥' : '🔒'}</span>
            <span>{isCorrect === true ? 'Simpan Data ke Misi ►' : 'Jawab Tantangan untuk Membuka Data'}</span>
          </button>
        </div>
      </motion.div>
    </div>
  )
}
