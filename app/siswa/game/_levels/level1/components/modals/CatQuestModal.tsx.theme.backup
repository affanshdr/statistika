'use client'

import React from 'react'
import { motion } from 'framer-motion'
import { gameAudio } from '@/lib/utils/gameAudio'

export interface MotherCatModalProps {
  stage: 'ask_help' | 'reminder' | 'reward'
  classLabel?: string
  onAccept?: () => void
  onClose: () => void
}

export function MotherCatModal({
  stage,
  classLabel = 'kelas',
  onAccept,
  onClose
}: MotherCatModalProps) {
  const isReward = stage === 'reward'
  const isAsk = stage === 'ask_help'

  return (
    <div
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 9999,
        background: 'rgba(5, 12, 24, 0.78)',
        backdropFilter: 'blur(6px)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        padding: 16,
      }}
      onClick={() => {
        if (isAsk && onAccept) onAccept()
        onClose()
      }}
    >
      <motion.div
        initial={{ opacity: 0, scale: 0.9, y: 15 }}
        animate={{ opacity: 1, scale: 1, y: 0 }}
        exit={{ opacity: 0, scale: 0.9, y: 15 }}
        transition={{ type: 'spring', damping: 25, stiffness: 350 }}
        onClick={e => e.stopPropagation()}
        style={{
          width: '100%',
          maxWidth: 480,
          background: 'linear-gradient(135deg, #FDF8EC 0%, #F5E8C7 100%)',
          border: '2.5px solid #8C6239',
          borderRadius: 24,
          boxShadow: '0 20px 50px rgba(0, 0, 0, 0.65), inset 0 0 25px rgba(180, 140, 80, 0.25)',
          padding: '26px 24px',
          color: '#362014',
          display: 'flex',
          flexDirection: 'column',
          gap: 16,
          position: 'relative',
        }}
      >
        {/* Decorative Viewfinder Brackets */}
        <div style={{ position: 'absolute', top: '10px', left: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '3px 0 0 0' }} />
        <div style={{ position: 'absolute', top: '10px', right: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 3px 0 0' }} />
        <div style={{ position: 'absolute', bottom: '10px', left: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '0 0 0 3px' }} />
        <div style={{ position: 'absolute', bottom: '10px', right: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 0 3px 0' }} />

        {/* Header with Cat Avatar & Tag */}
        <div style={{ display: 'flex', alignItems: 'center', gap: 14 }}>
          {/* Animated Cat Avatar Box */}
          <div
            style={{
              width: 56,
              height: 56,
              borderRadius: 16,
              background: '#FFFDF7',
              border: isReward ? '2px solid #059669' : '2px solid #8C6239',
              boxShadow: '0 2px 8px rgba(0,0,0,0.08)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              overflow: 'hidden',
              flexShrink: 0,
            }}
          >
            <div
              style={{
                width: 32,
                height: 32,
                backgroundImage: isReward ? "url('/Assets/CatPack/Box3.png')" : "url('/Assets/CatPack/Idle.png')",
                backgroundRepeat: 'no-repeat',
                backgroundSize: isReward ? '128px 32px' : '320px 32px',
                imageRendering: 'pixelated',
                transform: 'scale(1.5)',
              }}
            />
          </div>

          <div style={{ flex: 1 }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <span
                style={{
                  fontSize: 10.5,
                  fontWeight: 900,
                  padding: '2px 8px',
                  borderRadius: 6,
                  background: isReward ? '#059669' : '#B45309',
                  color: '#FFFFFF',
                  letterSpacing: '0.4px',
                  textTransform: 'uppercase',
                }}
              >
                {isReward ? 'Misi Selesai 🎉' : 'Misi Rahasia 🐾'}
              </span>
              <span style={{ fontSize: 11.5, color: '#0369A1', fontWeight: 800 }}>
                Depan {classLabel}
              </span>
            </div>
            <div style={{ fontSize: 18, fontWeight: 900, color: '#362014', marginTop: 3 }}>
              {isReward ? 'Mimi & Mochi Reunited!' : 'Induk Kucing (Mimi)'}
            </div>
          </div>
        </div>

        {/* Dialogue Body */}
        <div
          style={{
            background: '#FFFDF7',
            border: '1.5px solid #B48C50',
            borderRadius: 16,
            padding: '16px 18px',
            fontSize: 13.5,
            lineHeight: 1.6,
            color: '#362014',
            boxShadow: 'inset 0 2px 5px rgba(140, 98, 57, 0.1), 0 2px 6px rgba(0,0,0,0.04)',
          }}
        >
          {isAsk && (
            <>
              <strong style={{ color: '#B45309' }}>"Meooww...!</strong> Stevunt, syukurlah kamu lewat sini! Anak kecilku si <strong style={{ color: '#0284C7' }}>Mochi</strong> tadi bermain mengejar kupu-kupu dan masuk ke dalam kardus mainannya...
              <br /><br />
              Sekarang dia tersesat di salah satu area fasilitas atau halaman sekolah! Maukah kamu membantuku mencarinya?"
            </>
          )}

          {stage === 'reminder' && (
            <>
              <strong style={{ color: '#B45309' }}>"Meoww...?</strong> Mochi masih belum ketemu ya?
              <br /><br />
              Coba telusuri <strong style={{ color: '#0284C7' }}>Perpustakaan</strong>, <strong style={{ color: '#0284C7' }}>Lab Komputer</strong>, <strong style={{ color: '#0284C7' }}>Kantin</strong>, atau <strong style={{ color: '#0284C7' }}>Halaman Lapangan</strong>... Biasanya dia suka bersembunyi di dalam kardus di sudut yang tenang!"
            </>
          )}

          {isReward && (
            <>
              <strong style={{ color: '#059669' }}>"Purrrr... Meooww!</strong> Kamu menemukan Mochi! Lihat, dia langsung mendengkur tenang saat kembali ke dekatku.
              <br /><br />
              Terima kasih banyak ya Stevunt! Kamu siswa yang sangat teliti, peduli, dan berhati hangat!"
            </>
          )}
        </div>

        {/* Reward Badge Display when completed */}
        {isReward && (
          <div
            style={{
              background: '#ECFDF5',
              border: '1.5px dashed #059669',
              borderRadius: 14,
              padding: '12px 16px',
              display: 'flex',
              alignItems: 'center',
              gap: 12,
            }}
          >
            <div style={{ fontSize: 28 }}>🏅</div>
            <div>
              <div style={{ fontSize: 13, fontWeight: 900, color: '#065F46' }}>
                PENCAPAIAN DIBUKA: Sahabat Kucing SMP!
              </div>
              <div style={{ fontSize: 11.5, color: '#047857', fontWeight: 600 }}>
                Kamu berhasil menyelamatkan Mochi dan membawanya pulang ke induknya.
              </div>
            </div>
          </div>
        )}

        {/* Action Button */}
        <div style={{ display: 'flex', gap: 10, marginTop: 4 }}>
          {isAsk ? (
            <button
              className="game-btn game-btn-primary"
              onClick={() => {
                gameAudio.playCatMeow()
                if (onAccept) onAccept()
                onClose()
              }}
              style={{
                width: '100%',
                padding: '14px 20px',
                borderRadius: 14,
                fontSize: 14.5,
                fontWeight: 900,
                background: 'linear-gradient(135deg, #0E8388 0%, #0284C7 100%)',
                boxShadow: '0 6px 20px rgba(14, 131, 136, 0.35)',
                cursor: 'pointer',
                border: '1.5px solid rgba(255, 255, 255, 0.4)',
                color: '#FFFFFF',
              }}
            >
              🐾 Tentu, Aku Bantu Cari Mochi!
            </button>
          ) : (
            <button
              className="game-btn game-btn-primary"
              onClick={() => {
                if (isReward) gameAudio.playCatPurr()
                onClose()
              }}
              style={{
                width: '100%',
                padding: '14px 20px',
                borderRadius: 14,
                fontSize: 14,
                fontWeight: 900,
                background: isReward
                  ? 'linear-gradient(135deg, #10B981 0%, #059669 100%)'
                  : 'linear-gradient(135deg, #0E8388 0%, #0284C7 100%)',
                boxShadow: '0 6px 20px rgba(14, 131, 136, 0.35)',
                cursor: 'pointer',
                border: '1.5px solid rgba(255, 255, 255, 0.4)',
                color: '#FFFFFF',
              }}
            >
              {isReward ? '❤️ Sama-sama, Mimi & Mochi!' : '🔍 Siap, Aku Lanjutkan Mencari!'}
            </button>
          )}
        </div>
      </motion.div>
    </div>
  )
}

export interface KittenRescueModalProps {
  locationLabel: string
  onRescue: () => void
  onClose: () => void
}

export function KittenRescueModal({
  locationLabel,
  onRescue,
  onClose
}: KittenRescueModalProps) {
  return (
    <div
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 9999,
        background: 'rgba(5, 12, 24, 0.78)',
        backdropFilter: 'blur(6px)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        padding: 16,
      }}
      onClick={onClose}
    >
      <motion.div
        initial={{ opacity: 0, scale: 0.88, y: 20 }}
        animate={{ opacity: 1, scale: 1, y: 0 }}
        exit={{ opacity: 0, scale: 0.88, y: 20 }}
        transition={{ type: 'spring', damping: 25, stiffness: 350 }}
        onClick={e => e.stopPropagation()}
        style={{
          width: '100%',
          maxWidth: 460,
          background: 'linear-gradient(135deg, #FDF8EC 0%, #F5E8C7 100%)',
          border: '2.5px solid #8C6239',
          borderRadius: 24,
          boxShadow: '0 20px 50px rgba(0, 0, 0, 0.65), inset 0 0 25px rgba(180, 140, 80, 0.25)',
          padding: '26px 24px',
          color: '#362014',
          display: 'flex',
          flexDirection: 'column',
          alignItems: 'center',
          textAlign: 'center',
          gap: 16,
          position: 'relative',
        }}
      >
        {/* Decorative Viewfinder Brackets */}
        <div style={{ position: 'absolute', top: '10px', left: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '3px 0 0 0' }} />
        <div style={{ position: 'absolute', top: '10px', right: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 3px 0 0' }} />
        <div style={{ position: 'absolute', bottom: '10px', left: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '0 0 0 3px' }} />
        <div style={{ position: 'absolute', bottom: '10px', right: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 0 3px 0' }} />

        {/* Animated Kitten in Box */}
        <div
          style={{
            width: 80,
            height: 80,
            borderRadius: 20,
            background: '#FFFDF7',
            border: '2px solid #8C6239',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            overflow: 'hidden',
            boxShadow: '0 2px 8px rgba(0,0,0,0.1)',
          }}
        >
          <div
            style={{
              width: 32,
              height: 32,
              backgroundImage: "url('/Assets/CatPack/Box3.png')",
              backgroundRepeat: 'no-repeat',
              backgroundSize: '128px 32px',
              imageRendering: 'pixelated',
              transform: 'scale(2.2)',
            }}
          />
        </div>

        <div>
          <span
            style={{
              fontSize: 10.5,
              fontWeight: 900,
              padding: '2px 8px',
              borderRadius: 6,
              background: '#059669',
              color: '#FFFFFF',
              letterSpacing: '0.4px',
              textTransform: 'uppercase',
            }}
          >
            Anak Kucing Ditemukan! 📦
          </span>
          <div style={{ fontSize: 19, fontWeight: 900, color: '#362014', marginTop: 6 }}>
            Kamu Menemukan Mochi!
          </div>
          <div style={{ fontSize: 12, color: '#0369A1', fontWeight: 800, marginTop: 2 }}>
            Lokasi: {locationLabel}
          </div>
        </div>

        <div
          style={{
            background: '#FFFDF7',
            border: '1.5px solid #B48C50',
            borderRadius: 16,
            padding: '14px 16px',
            fontSize: 13,
            lineHeight: 1.6,
            color: '#362014',
            boxShadow: 'inset 0 2px 5px rgba(140, 98, 57, 0.1), 0 2px 6px rgba(0,0,0,0.04)',
          }}
        >
          <strong style={{ color: '#059669' }}>"Mewww...!"</strong>
          <br />
          Mochi mendongak dari dalam kardus dan mengibaskan ekornya dengan ceria saat melihatmu! Dia melompat ke pelukanmu dan siap dibawa kembali ke induknya.
        </div>

        <button
          className="game-btn game-btn-primary"
          onClick={() => {
            gameAudio.playCatMeow()
            onRescue()
            onClose()
          }}
          style={{
            width: '100%',
            padding: '14px 20px',
            borderRadius: 14,
            fontSize: 14,
            fontWeight: 900,
            background: 'linear-gradient(135deg, #10B981 0%, #059669 100%)',
            boxShadow: '0 6px 20px rgba(16, 185, 129, 0.35)',
            cursor: 'pointer',
            border: '1.5px solid rgba(255, 255, 255, 0.4)',
            color: '#FFFFFF',
          }}
        >
          🐾 Gendong Mochi & Bawa ke Induknya!
        </button>
      </motion.div>
    </div>
  )
}
