'use client'

import React, { useState, useEffect } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { QuizDoor } from '@/app/siswa/game/_levels/level1/data/level1Data'

function generateAnswerPool(correctVal: number): number[] {
  const pool = new Set<number>([correctVal])
  let delta = 1
  while (pool.size < 4) {
    const candidateHigh = correctVal + delta
    const candidateLow = correctVal - delta
    if (candidateHigh > 0 && pool.size < 4) pool.add(candidateHigh)
    if (candidateLow > 0 && pool.size < 4) pool.add(candidateLow)
    delta++
  }
  return Array.from(pool).sort(() => Math.random() - 0.5)
}

interface QuizModalProps {
  door: QuizDoor
  isFD: boolean
  onCorrect: () => void
  onClose: () => void
}

export default function QuizModal({ door, isFD, onCorrect, onClose }: QuizModalProps) {
  const [shake, setShake] = useState(0)
  const [wrongCount, setWrongCount] = useState(0)
  const [choices, setChoices] = useState<(number | string)[]>([])
  const [placedChoice, setPlacedChoice] = useState<number | string | null>(null)
  const [isCorrect, setIsCorrect] = useState(false)
  const [isWrong, setIsWrong] = useState(false)

  useEffect(() => {
    if (door.choices) {
      setChoices([...door.choices].sort(() => Math.random() - 0.5))
    } else {
      setChoices(generateAnswerPool(Number(door.quizA)))
    }
    setPlacedChoice(null)
    setIsCorrect(false)
    setIsWrong(false)
    setWrongCount(0)
  }, [door])

  const handlePlaceAnswer = (val: number | string) => {
    if (val === door.quizA) {
      setPlacedChoice(val)
      setIsCorrect(true)
      setIsWrong(false)
    } else {
      setPlacedChoice(val)
      setIsWrong(true)
      setIsCorrect(false)
      setShake(k => k + 1)
      setWrongCount(prev => prev + 1)
      setTimeout(() => {
        setPlacedChoice(null)
        setIsWrong(false)
      }, 800)
    }
  }

  const submit = () => {
    if (isCorrect) {
      onCorrect()
    }
  }

  const isTextQuestion = typeof door.quizA === 'string'

  return (
    <div style={{ position: 'fixed', inset: 0, zIndex: 500, background: 'rgba(20, 10, 5, 0.65)', backdropFilter: 'blur(8px)', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: 20 }}>
      <div style={{ display: 'flex', width: '100%', height: '100%', alignItems: 'center', justifyContent: 'center' }}>
        <motion.div
          initial={{ opacity: 0, scale: 0.88, y: 18 }}
          animate={{ opacity: 1, scale: 1, y: 0 }}
          exit={{ opacity: 0, scale: 0.88, y: 18 }}
          transition={{ type: 'spring', stiffness: 340, damping: 26 }}
          style={{
            maxWidth: 440,
            width: '100%',
            maxHeight: 'calc(100vh - 40px)',
            overflowY: 'auto',
            position: 'relative',
            background: 'linear-gradient(135deg, #FDF8EC 0%, #F5E8C7 100%)',
            border: '2.5px solid #8C6239',
            borderRadius: '24px',
            boxShadow: '0 20px 50px rgba(0, 0, 0, 0.65), inset 0 0 25px rgba(180, 140, 80, 0.25)',
            padding: '26px 22px',
            display: 'flex',
            flexDirection: 'column',
            gap: 16,
            color: '#362014',
          }}
        >
          {/* Decorative Viewfinder Brackets */}
          <div style={{ position: 'absolute', top: '10px', left: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '3px 0 0 0' }} />
          <div style={{ position: 'absolute', top: '10px', right: '10px', width: '14px', height: '14px', borderTop: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 3px 0 0' }} />
          <div style={{ position: 'absolute', bottom: '10px', left: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderLeft: '3px solid #8C6239', borderRadius: '0 0 0 3px' }} />
          <div style={{ position: 'absolute', bottom: '10px', right: '10px', width: '14px', height: '14px', borderBottom: '3px solid #8C6239', borderRight: '3px solid #8C6239', borderRadius: '0 0 3px 0' }} />

          {/* Header Badge */}
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 8 }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
              <span style={{
                background: '#FFFDF7',
                border: '1.5px solid #8C6239',
                borderRadius: '999px',
                padding: '3px 12px',
                fontSize: '12px',
                fontWeight: 900,
                color: '#362014',
                display: 'flex',
                alignItems: 'center',
                gap: '6px',
                boxShadow: '0 2px 4px rgba(0,0,0,0.06)',
              }}>
                <span>📍</span> {door.label}
              </span>
            </div>
            <span style={{ fontSize: 11, fontWeight: 900, color: '#9A3412', letterSpacing: '1px', textTransform: 'uppercase' }}>
              AKSES TERKUNCI
            </span>
          </div>

          <p style={{ margin: 0, fontSize: 14, fontWeight: 600, color: '#451A03', lineHeight: 1.55 }}>
            Di dalam pintu ini tersimpan sampel data investigasi. Jawab tantangan berikut untuk membuka kunci:
          </p>

          {/* Question Box */}
          <div style={{
            background: '#FFFDF7',
            border: '1.5px solid #B48C50',
            borderRadius: 14,
            padding: '16px 14px',
            textAlign: 'center',
            boxShadow: 'inset 0 2px 5px rgba(140, 98, 57, 0.1), 0 2px 6px rgba(0,0,0,0.04)'
          }}>
            <div style={{ fontSize: door.quizQ.length > 50 ? 14 : 15.5, fontWeight: 900, color: '#362014', lineHeight: 1.5 }}>
              &quot;{door.quizQ}&quot;
            </div>
          </div>

          {/* Choice Selection Grid */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: 10 }}>
            {choices.map((c, idx) => {
              const selected = placedChoice === c
              return (
                <button
                  key={idx}
                  onClick={() => handlePlaceAnswer(c)}
                  style={{
                    padding: '12px 10px',
                    borderRadius: 10,
                    background: selected
                      ? (isCorrect ? 'linear-gradient(135deg, #059669, #047857)' : 'linear-gradient(135deg, #DC2626, #B91C1C)')
                      : '#FFFFFF',
                    border: selected
                      ? (isCorrect ? '2px solid #065F46' : '2px solid #991B1B')
                      : '1.5px solid #CBD5E1',
                    color: selected ? '#FFFFFF' : '#334155',
                    fontWeight: 900,
                    fontSize: 14,
                    cursor: 'pointer',
                    transition: 'all 0.15s ease',
                    boxShadow: selected ? '0 4px 14px rgba(0,0,0,0.15)' : '0 2px 5px rgba(0,0,0,0.04)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    gap: 6
                  }}
                >
                  <span style={{ color: selected ? '#FFFFFF' : '#B45309', fontSize: 11 }}>►</span>
                  <span>{c}</span>
                </button>
              )
            })}
          </div>

          {/* Action Footer */}
          <div style={{ display: 'flex', gap: 12, marginTop: 6 }}>
            <button
              onClick={onClose}
              style={{
                flex: 1,
                padding: '12px 14px',
                borderRadius: 12,
                border: '1.5px solid #8C6239',
                background: '#F5E8C7',
                color: '#6B4226',
                fontSize: 13,
                fontWeight: 800,
                cursor: 'pointer',
              }}
            >
              ✕ Batal
            </button>
            <button
              disabled={!isCorrect}
              onClick={submit}
              style={{
                flex: 1.5,
                padding: '12px 16px',
                borderRadius: 12,
                border: isCorrect ? '1.5px solid rgba(255, 255, 255, 0.4)' : '1.5px solid #CBD5E1',
                background: isCorrect
                  ? 'linear-gradient(135deg, #0E8388 0%, #0284C7 100%)'
                  : '#E2E8F0',
                color: isCorrect ? '#FFFFFF' : '#94A3B8',
                fontSize: 13.5,
                fontWeight: 900,
                cursor: isCorrect ? 'pointer' : 'not-allowed',
                boxShadow: isCorrect ? '0 6px 20px rgba(14, 131, 136, 0.35)' : 'none',
              }}
            >
              🚪 Masuk Ruangan ►
            </button>
          </div>
        </motion.div>
      </div>
    </div>
  )
}
